{
  "name": "@officialunofficial/og",
  "version": "0.7.0",
  "description": "Primitives for rendering Open Graph card images on Fetch-API edge runtimes. Each product brings its own design.",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/officialunofficial/og.git"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "default": "./dist/render.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "docs/metadata.md"
  ],
  "keywords": [
    "open-graph",
    "og-image",
    "edge-runtime",
    "social-card"
  ],
  "packageManager": "bun@1.4.4",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun check",
    "test": "vitest run",
    "lint": "oxlint --deny-warnings src examples bench",
    "lint:pkg": "publint && attw --pack . --profile esm-only",
    "verify": "bun run lint && bun fmt --check src examples bench && bun check && bun run test && bun run build && bun run lint:pkg",
    "bench": "bun bench/run.ts"
  },
  "peerDependencies": {
    "@takumi-rs/wasm": ">=2.20.0 <3",
    "@takumi-rs/helpers": ">=2.20.0 <3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@takumi-rs/helpers": "^2.20.0",
    "@takumi-rs/wasm": "^2.20.0",
    "@types/node": "^26.6.6",
    "oxlint": "^1.71.0",
    "publint": "^0.3.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.8"
  },
  "peerDependenciesMeta": {
    "@takumi-rs/helpers": {
      "optional": true
    }
  }
}
